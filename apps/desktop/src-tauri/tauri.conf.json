{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ContextForge",
  "version": "0.1.0",
  "identifier": "dev.contextforge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "ContextForge", "width": 1280, "height": 840, "minWidth": 800, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "shortDescription": "Offline repository intelligence for developers",
    "category": "DeveloperTool",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
